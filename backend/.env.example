# Copiar a backend/.env (no versionado). Usar las mismas claves que infra/local/.env.
# Para correr las pruebas, apuntar a la base atlas_tests con sus usuarios.
ATLAS_ENTORNO=desarrollo
ATLAS_NIVEL_REGISTRO=INFO
ATLAS_BD_HOST=localhost
ATLAS_BD_PUERTO=5432
ATLAS_BD_NOMBRE=atlas_dev
ATLAS_BD_USUARIO=atlas_dev_app
ATLAS_BD_CLAVE=
ATLAS_BD_USUARIO_MIGRACION=atlas_dev_migracion
ATLAS_BD_CLAVE_MIGRACION=
# Tokens locales (DT-AUT-01): generar con `python -m atlas.herramientas.token_local --sub <sub>`.
# En AWS se usan el emisor y el cliente del User Pool, y el JWKS que provee el despliegue.
ATLAS_JWT_EMISOR=http://localhost/atlas-local
ATLAS_JWT_CLIENTE=atlas-local
ATLAS_JWT_JWKS_ARCHIVO=.claves_locales/jwks.json
