# Aplicación web de ATLAS (DO-2026-10-22-WEB). Copiar como .env.local (no versionado).
#
# Desarrollo local: la API se reenvía por el proxy de Vite (/api → uvicorn en 127.0.0.1:8000)
# y la sesión usa un token pegado (python -m atlas.herramientas.token_local --sub …).
VITE_ATLAS_API_URL=/api
VITE_ATLAS_AUTENTICACION=local
#
# Demo (F7): la aplicación corre en la máquina del presentador contra API Gateway.
# VITE_ATLAS_API_URL=https://<id>.execute-api.us-east-1.amazonaws.com
# VITE_ATLAS_AUTENTICACION=cognito
# VITE_ATLAS_COGNITO_REGION=us-east-1
# VITE_ATLAS_COGNITO_CLIENTE=<cognito_cliente_id>
